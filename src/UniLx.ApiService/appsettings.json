{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AccountBucket": {
    "BucketName": "cs-unilx-bucket",
    "Folder": "profile_pictures",
    "IsPrivate": "true"
  },
  "AdvertisementBucket": {
    "BucketName": "cs-unilx-bucket",
    "Folder": "advertisements",
    "IsPrivate": "false"
  },
  "Database": {
    "ConnectionString": "User Id=myuser;Password=mypassword;Server=localhost;Port=5432;Database=postgres;"
  },
  "MapsApi": {
    "Url": "https://maps.googleapis.com",
    "ApiKey": "",
    "TimeoutInSeconds": 30
  },
  "Aws": {
    "CognitoOptions": {
      "Authority": "",
      "Domain": "",
      "MetadataAddress": "",
      "WellKnown": "",
      "ClientId": "",
      "RoleClaimType": "cognito:groups"
    },
    "S3Options": {
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": ""
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "cs-Unilx-Api",
    "SecurityProtocol": "Plaintext",
    "Acks": "Leader",
    "RetryBackoffMaxMs": 100,
    "MessageSendMaxRetries": 5,
    "MessageTimeoutMs": 10000,
    "BatchNumMessages": 1000,
    "LingerMs": 5,
    "CreateAdvertisementTopic": {
      "Name": "CreateAdvertisementTopic"
    }
  }
}
